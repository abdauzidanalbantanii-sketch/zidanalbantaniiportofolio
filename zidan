    <script>
        // Active calculator tab state
        let currentCalcTab = 'asphalt';

        // Tab Switching for Calculator
        function switchCalcTab(tab) {
            currentCalcTab = tab;
            
            const btnAsphalt = document.getElementById('tab-asphalt');
            const btnConcrete = document.getElementById('tab-concrete');
            const boxAsphalt = document.getElementById('out-asphalt-box');
            const boxConcrete = document.getElementById('out-concrete-box');

            if (tab === 'asphalt') {
                btnAsphalt.classList.add('bg-primary', 'text-darker');
                btnAsphalt.classList.remove('text-gray-400', 'hover:text-white');
                btnConcrete.classList.remove('bg-primary', 'text-darker');
                btnConcrete.classList.add('text-gray-400', 'hover:text-white');
                boxAsphalt.classList.remove('hidden');
                boxConcrete.classList.add('hidden');
            } else {
                btnConcrete.classList.add('bg-primary', 'text-darker');
                btnConcrete.classList.remove('text-gray-400', 'hover:text-white');
                btnAsphalt.classList.remove('bg-primary', 'text-darker');
                btnAsphalt.classList.add('text-gray-400', 'hover:text-white');
                boxConcrete.classList.remove('hidden');
                boxAsphalt.classList.add('hidden');
            }
            calculateMaterial();
        }

        // Live material calculation function
        function calculateMaterial() {
            const length = parseFloat(document.getElementById('calc-length').value) || 0;
            const width = parseFloat(document.getElementById('calc-width').value) || 0;
            const thicknessCm = parseFloat(document.getElementById('calc-thickness').value) || 0;

            // Convert thickness to meter
            const thicknessM = thicknessCm / 100;
            const volume = length * width * thicknessM;

            // Update Volume Output
            document.getElementById('out-volume').innerText = volume.toFixed(2);

            if (currentCalcTab === 'asphalt') {
                // Tonnage of asphalt (density of compacted hotmix asphalt ~2.3 tons per cubic meter)
                const tonnage = volume * 2.3;
                document.getElementById('out-asphalt-weight').innerText = tonnage.toFixed(2);
            } else {
                // Standard 1:2:3 Concrete Mix per cubic meter estimates (Concrete Class roughly K-175 / K-225)
                // 1m3 requires: Cement ~ 326 kg (approx 8.2 bags of 40kg), Sand ~ 0.54 m3, Gravel ~ 0.82 m3
                const semenBags = Math.round(volume * 8.2);
                const pasirVol = (volume * 0.54).toFixed(1);
                const kerikilVol = (volume * 0.82).toFixed(1);

                document.getElementById('out-semen').innerText = semenBags;
                document.getElementById('out-pasir').innerText = pasirVol;
                document.getElementById('out-kerikil').innerText = kerikilVol;
            }
        }

        // Custom non-blocking visual Toast Notification
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `p-4 rounded-xl shadow-lg border text-sm font-semibold flex items-center gap-2 transition-all duration-300 translate-x-12 opacity-0 pointer-events-auto ${
                type === 'success' 
                ? 'bg-emerald-950 text-emerald-400 border-emerald-800' 
                : 'bg-amber-950 text-amber-400 border-amber-800'
            }`;
            
            toast.innerHTML = `
                <i class="${type === 'success' ? 'fas fa-circle-check' : 'fas fa-triangle-exclamation'}"></i>
                <span>${message}</span>
            `;

            container.appendChild(toast);

            // Trigger slide & fade-in animation
            setTimeout(() => {
                toast.classList.remove('translate-x-12', 'opacity-0');
            }, 10);

            // Destroy toast after 4 seconds
            setTimeout(() => {
                toast.classList.add('translate-x-12', 'opacity-0');
                setTimeout(() => {
                    toast.remove();
                }, 300);
            }, 4000);
        }

        // Interactive Redirection: WhatsApp
