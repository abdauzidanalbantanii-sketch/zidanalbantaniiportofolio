            const name = document.getElementById('form-name').value.trim();
            const company = document.getElementById('form-company').value.trim();
            const subject = document.getElementById('form-subject').value.trim();
            const message = document.getElementById('form-message').value.trim();

            if (!name || !subject || !message) {
                showToast("Harap isi formulir utama (Nama, Perihal, dan Pesan)", "warning");
                return;
            }

            const companyStr = company ? ` dari ${company}` : '';
            const formatMessage = `Halo Zidane Al-Bantani,\n\nSaya *${name}*${companyStr}.\n\n*Perihal:* ${subject}\n\n*Pesan:*\n${message}`;
            
            const encodedText = encodeURIComponent(formatMessage);
            const waUrl = `https://wa.me/6283870181323?text=${encodedText}`;
            
            showToast("Mengalihkan Anda ke WhatsApp...");
            setTimeout(() => {
                window.open(waUrl, '_blank');
            }, 800);
        }

        // Interactive Redirection: Email
        function redirectToEmail() {
            const name = document.getElementById('form-name').value.trim();
            const company = document.getElementById('form-company').value.trim();
            const subject = document.getElementById('form-subject').value.trim();
            const message = document.getElementById('form-message').value.trim();

            if (!name || !subject || !message) {
                showToast("Harap isi formulir utama (Nama, Perihal, dan Pesan)", "warning");
                return;
            }

            const companyStr = company ? ` dari ${company}` : '';
            const mailtoUrl = `mailto:abdauzidanalbantanii@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent("Halo Zidane,\n\nNama Saya: " + name + companyStr + "\n\nKebutuhan:\n" + message)}`;
            
            showToast("Membuka aplikasi Email Anda...");
            setTimeout(() => {
                window.location.href = mailtoUrl;
            }, 800);
        }

        // Initialize Calculator default state
        calculateMaterial();

        // Mobile Menu Toggle
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');

        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
        });

        // Close mobile menu when link is clicked
        const mobileLinks = menu.querySelectorAll('a');
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                menu.classList.add('hidden');
            });
        });

        // Navbar Background Change on Scroll
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('bg-darker/90', 'backdrop-blur-md', 'shadow-lg');
                navbar.classList.remove('bg-transparent');
            } else {
                navbar.classList.remove('bg-darker/90', 'backdrop-blur-md', 'shadow-lg');
                navbar.classList.add('bg-transparent');
            }
        });

        // Initial check for navbar bg
        if (window.scrollY > 50) {
            navbar.classList.add('bg-darker/90', 'backdrop-blur-md', 'shadow-lg');
        }

        // Intersection Observer for Fade-in Animations
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.15
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, observerOptions);

        // Select all elements with fade-in class
        const fadeElements = document.querySelectorAll('.fade-in');
        fadeElements.forEach(el => observer.observe(el));

        // Typewriter Effect for Hero Subtitle
        const typeTarget = document.getElementById('typewriter');
        const typingTexts = [
            "Supervisor Lapangan",
            "Konsultan Pengawas",
            "Mahasiswa Sistem Informasi"
        ];
        let typeTextIndex = 0;
        let charIndex = 0;
        let isDeleting = false;

        function typeWriterLoop() {
            const currentText = typingTexts[typeTextIndex];
            
            if (isDeleting) {
                typeTarget.innerHTML = currentText.substring(0, charIndex - 1);
                charIndex--;
            } else {
                typeTarget.innerHTML = currentText.substring(0, charIndex + 1);
                charIndex++;
            }

            let typeSpeed = isDeleting ? 40 : 80;

            if (!isDeleting && charIndex === currentText.length) {
                typeSpeed = 2000; 
                isDeleting = true;
            } else if (isDeleting && charIndex === 0) {
                isDeleting = false;
                typeTextIndex = (typeTextIndex + 1) % typingTexts.length;
                typeSpeed = 500; 
            }

            setTimeout(typeWriterLoop, typeSpeed);
        }

        // Start typewriter on load
        setTimeout(typeWriterLoop, 800);
    </script>
</body>
</html>
